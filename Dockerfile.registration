# Registration web app for MapleStory Co-op Remix (separate JVM process).
# It only serves /, /register and /health/ready and talks to MySQL over an
# internal Docker network. No WZ data, no scripts, no game config, no secrets.
#
# Build context is the repository root (same as the game image):
#   docker build -f Dockerfile.registration -t maple-registration .
#
# The image builds the fat jar from the checked-in source so it cannot silently
# package a stale local target/Cosmic.jar. Secrets are provided at runtime.

FROM maven:3.9.6-amazoncorretto-21@sha256:d1412a52e10b30ed42818c7a9d66ee75873c700579abc6671c27b98941940fec AS build

WORKDIR /opt/cosmic
COPY pom.xml ./pom.xml
COPY src ./src
RUN mvn -f ./pom.xml clean package -Dmaven.test.skip \
    -Dproject.build.outputTimestamp=2026-09-02T00:00:00Z -T 1C

FROM eclipse-temurin:21-jre-jammy@sha256:eebd356ad7358b7094758e5787a6726f332917cfd56feab6457c56dab895cdbf

# Non-root service user/group (fixed uid/gid so mounted secret files can be
# chowned on the host without surprises).
RUN groupadd --gid 10001 registration \
    && useradd --uid 10001 --gid registration --no-create-home \
       --home-dir /opt/registration --shell /usr/sbin/nologin registration

ENV REG_RESOURCE_DIR=/opt/registration/public \
    REG_PORT=8080 \
    JAVA_TOOL_OPTIONS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=70 -Dfile.encoding=UTF-8"

WORKDIR /opt/registration

# Fat jar built in the first stage. Renamed to a neutral service name.
COPY --from=build /opt/cosmic/target/Cosmic.jar /opt/registration/app.jar
# Static public assets (index.html, assets/register.css).
COPY src/main/resources/coop/registration/public /opt/registration/public

RUN chown -R registration:registration /opt/registration \
    && chmod 550 /opt/registration \
    && chmod 440 /opt/registration/app.jar \
    && find /opt/registration/public -type d -exec chmod 550 {} \; \
    && find /opt/registration/public -type f -exec chmod 440 {} \;

USER registration:registration

# Internal container port only; published through Caddy, never directly.
EXPOSE 8080

# The image stays minimal on purpose: no HTTP client (curl/wget) is installed,
# so the probe uses bash /dev/tcp. It asks the app's own /health/ready endpoint,
# which answers 200 "ready" only while the DB connection pool is reachable
# (503 otherwise) - see docs/DEPLOYMENT.md.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD bash -c 'exec 3<>"/dev/tcp/127.0.0.1/${REG_PORT:-8080}" || exit 1; \
printf "GET /health/ready HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n" >&3; \
head -n 1 <&3 | grep -q " 200 "'

# No shell form: REG_* variables and secret *file paths* come from the
# environment/compose, never from image layers.
ENTRYPOINT ["java", "-cp", "/opt/registration/app.jar", "coop.registration.RegistrationServerMain"]
