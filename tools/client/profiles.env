# Supported endpoint profiles for tools/client/build-client-profile.sh.
# IPs only — never put credentials or secrets here.
# The build script rejects every profile except local-dev, vps-dev and vps-prod.
#
# local-dev:  server and client run on the same machine (compose exposes login 8484,
#             channels 7575-7577). The stock Cosmic client already targets 127.0.0.1,
#             so local-dev needs no binary patching.
PROFILE_local_dev_ip=127.0.0.1

# Future VPS endpoints — fill in once the VPS exists; empty values make the build
# script refuse instead of producing a wrongly-patched client.
PROFILE_vps_dev_ip=
PROFILE_vps_prod_ip=
