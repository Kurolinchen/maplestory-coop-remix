<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Co-op Remix 0.1b (Slice A.3, audit fix B9):
        Add a UNIQUE(accountid, world) constraint on storages so two concurrent
        loadOrCreateFromDB calls cannot race-create duplicate storage rows. Pre-
        existing duplicates (if any) are reduced to one canonical row per
        (accountid, world) pair before the constraint is added.

        Together with the saveToDB audit fix (B8) this prevents item/meso drift
        caused by interleaved storage updates and orphan storage rows.
    -->
    <changeSet id="coop-1032" author="coop">
        <comment>Co-op Remix 0.1b: dedupe storages and add UNIQUE(accountid, world).</comment>

        <!-- Reduce duplicates: keep the lowest storageid per (accountid, world). -->
        <sql>
            DELETE s1 FROM storages s1
              INNER JOIN storages s2
                ON s1.accountid = s2.accountid
               AND s1.world = s2.world
               AND s1.storageid > s2.storageid;
        </sql>

        <addUniqueConstraint tableName="storages"
                             columnNames="accountid, world"
                             constraintName="uq_storages_account_world"/>
    </changeSet>
</databaseChangeLog>
