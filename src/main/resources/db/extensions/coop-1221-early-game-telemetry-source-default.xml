<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="coop-1221" author="coop">
        <comment>Use a truthful default when the generic EXP pipeline cannot identify a source.</comment>
        <dropDefaultValue tableName="coop_early_game_exp_log"
                          columnName="source" columnDataType="VARCHAR(16)"/>
        <addDefaultValue tableName="coop_early_game_exp_log"
                         columnName="source" columnDataType="VARCHAR(16)"
                         defaultValue="UNATTRIBUTED"/>
    </changeSet>
</databaseChangeLog>
