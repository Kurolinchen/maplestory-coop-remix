## Registration service (coop/registration) - PLACEHOLDERS ONLY.
## Copy to a gitignored file (e.g. /opt/maple-dev/config/registration.env, chmod 600)
## and fill in the values on the VPS. Never commit a filled-in copy.
## Secrets are read from FILES, never passed as command-line arguments.

## Public origin the app is served under. Must match the Host header
## (and the browser Origin header) or every request is answered with 403.
REG_PUBLIC_ORIGIN=https://dream-ms.duckdns.org

## JDBC URL. Host must be the compose service name on the internal network;
## the registration DB user has no access from anywhere else.
REG_JDBC_URL=jdbc:mysql://db:3306/cosmic?useSSL=false&allowPublicKeyRetrieval=true

## Least-privilege DB user (provisioned by ops provisioning, not by Liquibase).
REG_DB_USER=registration

## Path to a file containing the DB password (chmod 600, owned by the service
## user). Mounted into the container, never part of the image.
REG_DB_PASSWORD_FILE=/run/secrets/reg_db_password

## Path to a file containing the invite passphrase (chmod 600). Everyone who
## knows the passphrase can create accounts, so rotating this file rotates
## access.
REG_INVITE_FILE=/run/secrets/reg_invite_passphrase

## Internal listen port of the app (Caddy proxies to it; do not publish it).
REG_PORT=8080

## Rate limits: registration attempts per client IP per window (15 min window)
## and the global hourly cap across all clients.
REG_PER_IP_BURST=2
REG_GLOBAL_HOURLY_CAP=20

## Exact internal IP address of Caddy. Forwarded client-IP headers are ignored
## unless the immediate peer appears here. Leave empty until Compose assigns a
## fixed address; never list a whole public or Docker subnet.
REG_TRUSTED_PROXY_IPS=172.30.250.2

## Static assets inside the container (matches the image layout).
REG_RESOURCE_DIR=/opt/registration/public
